package Inheritance;

class Area {
    int area(int side) {
        return side * side;
    }

    int area(int length, int width) {
        return length * width;
    }
}

public class Main {
    public static void main(String[] args) {
        Area obj = new Area();
        System.out.println(obj.area(3));    
        System.out.println(obj.area(3, 5)); 
    }
}
